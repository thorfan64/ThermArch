# Copy this file to backend/.env and fill in your key.
# Get a free key at https://home.openweathermap.org/api_keys

OPENWEATHER_API_KEY=your_key_here

PORT=5000

# Windows 11: use "python" if `python --version` works,
# otherwise use "py" (the Python launcher).
PYTHON_COMMAND=python

PYTHON_TIMEOUT_MS=10000
WEATHER_TIMEOUT_MS=8000
FRONTEND_ORIGIN=http://localhost:5173
